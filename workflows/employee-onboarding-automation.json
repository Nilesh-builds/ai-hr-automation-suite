    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "=Welcome to the Team, {{ $json.FirstName }}! 🎉",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; text-align: center; }\n    .content { padding: 30px; }\n    .checklist { background: #f8f9fa; padding: 20px; border-radius: 10px; margin: 20px 0; }\n    .checklist li { margin: 10px 0; }\n    .button { background: #667eea; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; display: inline-block; }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>Welcome Aboard! 🚀</h1>\n  </div>\n  <div class=\"content\">\n    <h2>Hi {{ $json.FirstName }},</h2>\n    <p>We're absolutely thrilled to have you join our team on <strong>{{ $json.JoiningDate }}</strong>!</p>\n    \n    <div class=\"checklist\">\n      <h3>📋 Before Your First Day:</h3>\n      <ul>\n        <li>📄 Complete your documentation</li>\n        <li>📷 Send a professional photo for your ID card</li>\n        <li>🏦 Share bank details for payroll setup</li>\n        <li>📱 Download our company app</li>\n      </ul>\n    </div>\n    \n    <div class=\"checklist\">\n      <h3>📍 What to Expect on Day 1:</h3>\n      <ul>\n        <li>🕙 Report at 10:00 AM</li>\n        <li>👥 Meet your buddy and team</li>\n        <li>💻 Collect your laptop and access cards</li>\n        <li>🍽️ Team lunch!</li>\n      </ul>\n    </div>\n    \n    <p>Your manager <strong>{{ $json.ManagerName }}</strong> is excited to welcome you!</p>\n    \n    <p>Questions? Just reply to this email or reach out on WhatsApp.</p>\n    \n    <p>Best regards,<br><strong>HR Team</strong></p>\n  </div>\n</body>\n</html>",
        "options": {}
      },
