      "id": "b1c2d3e4-2222-2222-2222-222222222222",
      "name": "Get New Hires",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [460, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "your-google-credential-id",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filter employees with pending onboarding tasks\nconst employees = $input.all();\nconst today = new Date();\n\nconst pendingOnboardings = employees.filter(emp => {\n  const status = emp.json.OnboardingStatus;\n  return status === 'Pending' || status === 'In Progress';\n}).map(emp => {\n  const joiningDate = new Date(emp.json.JoiningDate);\n  const daysUntilJoining = Math.ceil((joiningDate - today) / (1000 * 60 * 60 * 24));\n  \n  // Determine which tasks to trigger\n  const tasks = [];\n  \n  // 7 days before - Welcome email\n  if (daysUntilJoining <= 7 && daysUntilJoining > 3 && !emp.json.WelcomeEmailSent) {\n    tasks.push('send_welcome_email');\n  }\n  \n  // 3 days before - IT setup\n  if (daysUntilJoining <= 3 && daysUntilJoining > 0 && !emp.json.ITSetupRequested) {\n    tasks.push('request_it_setup');\n  }\n  \n  // 1 day before - Final reminder\n  if (daysUntilJoining === 1 && !emp.json.FinalReminderSent) {\n    tasks.push('send_final_reminder');\n  }\n  \n  // Joining day\n  if (daysUntilJoining <= 0 && !emp.json.Day1Completed) {\n    tasks.push('send_day1_checklist');\n    tasks.push('schedule_orientation');\n  }\n  \n  return {\n    json: {\n      ...emp.json,\n      daysUntilJoining,\n      pendingTasks: tasks,\n      hasTasks: tasks.length > 0\n    }\n  };\n}).filter(emp => emp.json.hasTasks);\n\nreturn pendingOnboardings;"
      },
      "id": "b1c2d3e4-3333-3333-3333-333333333333",
      "name": "Calculate Pending Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
